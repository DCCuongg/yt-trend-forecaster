DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-yt-trend-forecaster-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Cấu hình PostgreSQL (Local Docker hoặc Cloud Neon/Supabase)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=yt_trend_db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=db
DB_PORT=5432

# Hugging Face Hub (Dùng để kéo trọng số model & dataset Gold)
HF_TOKEN=your_huggingface_read_token_here # Đang để chính sách public
HF_MODEL_REPO=cuongduongok/yt-trend-forecaster-models
HF_DATASET_REPO=cuongduongok/yt-trend-forecaster-gold-data

# Chế độ chạy Inference: LOCAL hoặc REMOTE
INFERENCE_MODE=LOCAL
COLAB_WORKER_URL=
COLAB_WORKER_KEY=